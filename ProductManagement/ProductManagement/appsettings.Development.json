{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Server=postgres;Database=products;Userid=user;Password=password;Port=5432;Pooling=true;SSL Mode=Prefer;Trust Server Certificate=true"
  },
  "ProducerOptions": {
    "BootstrapServers": "kafka:29092",
    "Topic": "product-events",
    "Acks": "all",
    "MessageSendMaxRetries": 3,
    "EnableIdempotence": false
  },
  "ConsumerOptions": {
    "BootstrapServers": "kafka:29092",
    "Topic": "inventory-events",
    "GroupId": "product-consumer-group"
  },
  "ProductConfig": {
    "MinimumMediaCount": 0
  },
  "StorageConfig": {
    "Endpoint": "object-store:9000",
    "AccessKey": "example",
    "SecretKey": "example"
  },
  "AllowedHosts": "*"
}
