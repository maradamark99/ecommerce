{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProductManagementClientConfig": {
    "BaseUrl": "http://product-management-api:8080"
  },
  "ProducerOptions": {
    "BootstrapServers": "kafka:29092",
    "Topic": "cart-events",
    "Acks": "all",
    "MessageSendMaxRetries": 3,
    "EnableIdempotence": false
  }
}
