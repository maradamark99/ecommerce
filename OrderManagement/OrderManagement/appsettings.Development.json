{
  "ConnectionStrings": {
    "Database": "Host=postgres;Port=5432;Database=orders;Username=user;Password=password;"
  },
  "ProducerOptions": {
    "BootstrapServers": "kafka:29092",
    "Topic": "order-events",
    "Acks": "all",
    "MessageSendMaxRetries": 3,
    "EnableIdempotence": false
  },
  "PaymentClientConfig": {
    "BaseUrl": "http://payment-api:8080",
    "Endpoint": "/api/v1/payments"
  },
  "InventoryClientConfig": {
    "BaseUrl": "http://inventory-api:8080",
    "Endpoint": "/api/v1/inventory"
  },
  "ShippingClientConfig": {
    "BaseUrl": "http://shipping-api:8080",
    "Endpoint": "/api/v1/shipping"
  },
  "CartEventConsumerConfig": {
    "BootstrapServers": "kafka:29092",
    "Topic": "cart-events",
    "GroupId": "order-consumer-group"
  },
  "ShippingEventConsumerConfig": {
    "BootstrapServers": "kafka:29092",
    "Topic": "shipping-events",
    "GroupId": "order-consumer-group"
  },
  "PaymentEventConsumerConfig": {
    "BootstrapServers": "kafka:29092",
    "Topic": "payment-events",
    "GroupId": "order-consumer-group"
  }
}