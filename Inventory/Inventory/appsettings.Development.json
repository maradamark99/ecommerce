{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Host=postgres;Port=5432;Database=inventory;Username=user;Password=password;"
  },
  "ProducerOptions": {
    "BootstrapServers": "kafka:29092",
    "Topic": "inventory-events",
    "Acks": "all",
    "MessageSendMaxRetries": 3,
    "EnableIdempotence": false
  },
  "ProductEventConsumerConfig": {
    "BootstrapServers": "kafka:29092",
    "Topic": "product-events",
    "GroupId": "inventory-consumer-group"
  },
  "OrderEventConsumerConfig": {
    "BootstrapServers": "kafka:29092",
    "Topic": "order-events",
    "GroupId": "inventory-consumer-group"
  },
  "AllowedHosts": "*"
}
