{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConsumerOptions": {
    "BootstrapServers": "localhost:9092",
    "Topic": "order-events",
    "GroupId": "shipping-consumer-group"
  },
  "ProducerOptions": {
    "BootstrapServers": "localhost:9092",
    "Topic": "shipping-events",
    "Acks": "all",
    "MessageSendMaxRetries": 3,
    "EnableIdempotence": false
  },
  "AllowedHosts": "*"
}
